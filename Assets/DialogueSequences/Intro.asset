  m_Script: {fileID: 11500000, guid: 36712e6ef0a137f4e86a5d5cf920dff0, type: 3}
  m_Name: Intro
  m_EditorClassIdentifier: 
  flagOnStart: 
  lines:
  - Agent|Agent, you there?
  - Agent|Before you go in, a reminder that your only directive is to locate Dr.Gershwin.
  - Agent|We haven't heard from the facility in several hours. We assume something
    disastorous has occured, but equipment is replacable.
  - Agent|Even, some personel are.
  - Agent|But the Doctor is not.
  - Agent|Without his mind, there's no way that we'll able to figure out how to fix
    whatever happened here.
  - Agent|Make sure you find him.
  - Agent|Your armor's operating system should be synced to the facility's network.
    Hopefully that comes in handy.
  - Agent|And one more thing.
  - "Agent|We're fairly certain the situati\u2014do wi\u2014"
  - "Agent|They'll be\u2014 watch yours\u2014"
  - "Agent|Agent? Do you\u2014"
  - "Agent|\u2014 \u2014 \u2014 \u2014 \u2014 \u2014 \u2014 \u2014 \u2014 \u2014
    \u2014kzzt..."
  flagOnEnd: intro_end
  autoTime: 0
  overwritable: 0
